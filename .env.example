PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Provider keys (at least one recommended in production)
EODHD_API_TOKEN=
FMP_API_KEY=
OPENBB_BASE_URL=
OPENBB_API_KEY=

# Redis is optional. Without REDIS_URL the service uses an in-process LRU cache.
REDIS_URL=

CACHE_TTL_QUOTE_SECONDS=60
CACHE_TTL_FUNDAMENTALS_SECONDS=43200
CACHE_TTL_CRYPTO_SECONDS=120
CACHE_TTL_MACRO_SECONDS=300

# Synthetic fixtures for identifiers in the institutional spec when providers are down or unconfigured.
ENABLE_DEMO_FIXTURES=true

HTTP_TIMEOUT_MS=12000
HTTP_RETRIES=2

# SpaceXAI (xAI) — qualitative synthesis only. Math is never delegated to the model.
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_MS=45000

# Markets Digest contacts. Leave empty until a real key is set.
# Without it, POST /api/newsletter returns 503 not_configured.
RESEND_API_KEY=
